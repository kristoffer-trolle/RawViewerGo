# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Android / Gradle
/local.properties
/build/
/app/build/
/.gradle/
/.idea/
*.iml
.cxx/
captures/

# Gradle wrapper jar must be committed for ./gradlew to work
!gradle/wrapper/gradle-wrapper.jar

# build/RawViewerGo.apk (a convenience copy for sideloading) is also caught by /build/ above.

# enhance_tuning/ holds personal sample photos and generated previews (not for git) alongside
# the actual dev tooling used to generate them (tracked below).
/enhance_tuning/*
!/enhance_tuning/EnhanceRunner.java
!/enhance_tuning/render.sh
